NODE_ENV=development

# -----------------------------------------------------------------------------
# Required Core Configuration
# -----------------------------------------------------------------------------

# PostgreSQL database connection string
# Replace 'postgres' and 'your_password' with your PostgreSQL username and password
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketeros"

# Session secret for signed cookies (must be at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="marketeros_super_secret_session_key_min_32_characters_long"

# Encryption key for securing provider tokens at rest (must be exactly 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis queue for background jobs (optional in dev)
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Optional Integrations (Required only when enabling specific provider features)
# -----------------------------------------------------------------------------

# Google OAuth & Ads
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/integrations/oauth/callback"
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CUSTOMER_ID=""

# Meta (Facebook & Instagram)
META_CLIENT_ID=""
META_CLIENT_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/integrations/oauth/callback"

# AI Content & Insight Generation
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Lead Discovery & Maps
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Billing Providers (Stripe & Razorpay)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_YEARLY=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Object Storage (S3-compatible) for production assets
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

