# =============================================================================
# MarketerOS - Environment Configuration (.env.example)
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. Required Core Configuration
# -----------------------------------------------------------------------------

# PostgreSQL database connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/marketeros"
# Direct (non-pooled) connection used by Prisma Migrate. Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/marketeros"
# Production on Vercel + Supabase:
#   DATABASE_URL = transaction pooler, port 6543, with ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct connection, port 5432 (used only by `prisma migrate deploy`)

# Public URL of this app. Required in production: password reset and email verification links point here.
APP_URL="http://localhost:3000"

# Session secret for signed authentication cookies (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="marketeros_super_secret_session_key_min_32_characters_long"

# Encryption key for securing user provider credentials at rest (AES-256-GCM, exactly 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis queue for background jobs (optional in dev)
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 2. Google Marketing Ecosystem (100% BYOK - ZERO Server Keys Required)
# -----------------------------------------------------------------------------
# Google Ads, Google Analytics (GA4), Search Console, Firebase & AdMob
# do NOT require any API keys in this file.
# Users provide their Developer Tokens, Customer IDs, Service Account keys,
# and OAuth tokens directly through the application UI modal.
# All user credentials are encrypted with AES-256-GCM and stored per-tenant.

# -----------------------------------------------------------------------------
# 3. Optional Platform Services (Configure only if host enables these features)
# -----------------------------------------------------------------------------

# AI Content & Insight Generation
# Compatible with any OpenAI-compatible provider:
#
# Option 1: Google Gemini (100% FREE - Get key from https://aistudio.google.com)
# OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# OPENAI_API_KEY="AIzaSy..."
# OPENAI_MODEL="gemini-3.6-flash"
#
# Option 2: Groq Cloud (100% FREE & Ultra-Fast - Get key from https://console.groq.com)
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_API_KEY="gsk_..."
# OPENAI_MODEL="llama-3.3-70b-versatile"
#
# Option 3: Standard OpenAI (Requires API credits from https://platform.openai.com)
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Stripe Subscription & Billing (Optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayU Payment Gateway (Test Mode / Production)
# Configure your PayU Merchant Key & Salt from https://test.payu.in/ or https://www.payu.in/
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_ENV="test"

# -----------------------------------------------------------------------------
# 4. Email Delivery (verification, password reset, team invitations)
# -----------------------------------------------------------------------------
# Without a provider, links are printed to the server console in development only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE="false"
# Or Resend (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM=""

# -----------------------------------------------------------------------------
# 5. Media Storage (Content Studio uploads)
# -----------------------------------------------------------------------------
# "local" (default) writes to ./storage/uploads: development and single-server hosting only.
# "s3" works with AWS S3, Cloudflare R2 or Supabase Storage (set S3_ENDPOINT for non-AWS providers).
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# With S3, browsers upload directly to the bucket (presigned URLs), so Vercel's 4.5 MB request limit doesn't apply.
# The bucket needs a CORS rule allowing PUT with a Content-Type header from APP_URL's origin.
# The upload origin is added to the Content-Security-Policy at build time; override it if it differs:
S3_PUBLIC_UPLOAD_ORIGIN=""
# Maximum upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=""

# -----------------------------------------------------------------------------
# 6. Background Jobs (report generation, integration syncs)
# -----------------------------------------------------------------------------
# Servers/containers: run `npm run worker` alongside the app.
# Vercel: vercel.json calls /api/cron/jobs every minute; set CRON_SECRET in the Vercel project.
CRON_SECRET=""
WORKER_POLL_INTERVAL_MS="5000"

# -----------------------------------------------------------------------------
# 7. Error Monitoring (Sentry, optional; disabled while the DSNs are empty)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0"
# Source map upload during builds (CI/deploys only)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
